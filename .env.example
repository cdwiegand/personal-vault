# Copy to .env  (never commit .env — it holds secrets).  Used by docker-compose.
#
# Your vault is bind-mounted from ./vault and the OAuth store from ./data (see docker-compose.yml).
# Put your vault at ./vault (move it, or symlink: `ln -s /path/to/vault ./vault`) and `mkdir -p data`.

# User/group that owns ./vault and ./data, so the container can read/write them. `id -u` / `id -g`.
PUID=1000
PGID=1000

# ---- Auth (read by the app) ----
# Must exactly equal the https URL you enter into Claude (no trailing slash, no path).
Auth__PublicBaseUrl=https://vault.example.com
Auth__Username=chris

# Generate:  docker compose run --rm vault-mcp hash-password 'your-password'
# (delimiter is '.', not '$', so paste it as-is — no escaping needed)
Auth__PasswordHash=pbkdf2.210000.REPLACE.REPLACE

# Generate:  openssl rand -base64 32     (>= 32 bytes; keep secret; rotating it logs you out)
Auth__JwtSigningKey=REPLACE_WITH_BASE64_32_BYTES
