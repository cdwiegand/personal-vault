# Copy to /etc/obsidian-vault-mcp.env, fill in, then: sudo chmod 600 /etc/obsidian-vault-mcp.env
# Configuration is via double-underscore env vars (Section__Key). These override appsettings.json.

# --- Vault ---
Vault__Root=/home/chris/vault
Vault__ReadOnly=false
Vault__AllowDelete=false

# --- Auth ---
# PublicBaseUrl is the exact HTTPS origin Claude reaches (no trailing slash, no path).
Auth__PublicBaseUrl=https://vault.example.com
Auth__Username=chris

# Generate with:  dotnet run -- hash-password
Auth__PasswordHash=pbkdf2$210000$....$....

# Generate with:  openssl rand -base64 32   (>= 32 bytes; keep secret; rotating it logs you out)
Auth__JwtSigningKey=REPLACE_WITH_BASE64_32_BYTES

# Where to keep client registrations / refresh tokens (must be writable):
Auth__StorePath=/opt/obsidian-vault-mcp/oauth-store.db
